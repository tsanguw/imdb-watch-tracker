TMDB_API_KEY=your_tmdb_v3_api_key
YOUTUBE_API_KEY=your_youtube_data_api_key

# Point these at your private data repo's local clone, NOT at data/ in this
# (public) repo — see README "Keeping your data private". Example assuming
# it's cloned as a sibling folder next to this one:
WATCHLIST_CSV_PATH=../imdb-watch-tracker-data/imdb_watchlist_export.csv
OUTPUT_PATH=../imdb-watch-tracker-data/watchlist.xlsx

# Optional overrides:
# TMDB_REGION=US
# FORCE_YOUTUBE_RECHECK=false
